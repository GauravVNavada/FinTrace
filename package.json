    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "turbo": "^2.5.6"
  },
  "packageManager": "pnpm@11.7.0"
}
