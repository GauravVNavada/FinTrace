{
  "name": "fintrace",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check:ui-architecture": "node scripts/check-ui-architecture.mjs",
    "test:web-regression": "node --experimental-strip-types --test apps/web/lib/exception-detail-loader.test.ts",
    "test:e2e": "pnpm build && playwright test",
