APP_ENV=development
APP_NAME=FinTrace API
API_PREFIX=/api/v1
DATABASE_URL=postgresql://fintrace:fintrace@localhost:55432/fintrace
STORAGE_BACKEND=postgres
MIGRATIONS_DIR=migrations
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
LOG_LEVEL=INFO
AI_PROVIDER=gemini
# Use gemini or groq for live calls. Provider-specific keys are preferred.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash-lite
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_PROVIDER=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AUTH_MODE=development
# Staging/production force AUTH_MODE=required and reject header-only context.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ISSUER=fintrace
AUTH_AUDIENCE=fintrace-web
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_UNCOMPRESSED_BYTES=52428800
MAX_UPLOAD_ZIP_MEMBERS=2000
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
