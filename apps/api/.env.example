APP_ENV=development
APP_NAME=FinTrace API
API_PREFIX=/api/v1
DATABASE_URL=postgresql://fintrace:fintrace@localhost:55432/fintrace
STORAGE_BACKEND=demo
MIGRATIONS_DIR=migrations
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
LOG_LEVEL=INFO
AI_PROVIDER=stub
# Use gemini or groq for live calls. The first non-empty key for the selected
# provider is used when AI_API_KEY is blank. Set AI_API_KEY explicitly to pick
# another key. Requests retry remaining keys for rate-limit/transient/auth
# failures; switching between Gemini and Groq remains a manual provider choice.
AI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
AI_BASE_URL=https://api.openai.com/v1
# Example live settings:
# Gemini: AI_PROVIDER=gemini, AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, AI_MODEL=gemini-3.6-flash
# Groq:   AI_PROVIDER=groq, AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=openai/gpt-oss-120b
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AUTH_MODE=development
# Staging/production force AUTH_MODE=required and reject header-only context.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ISSUER=fintrace
AUTH_AUDIENCE=fintrace-web
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_UNCOMPRESSED_BYTES=52428800
MAX_UPLOAD_ZIP_MEMBERS=2000
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
